# HAL file for fraese.ini: gantry mill on the cncboard real-time board (SPI).
#
# Board inputs used here (see docs/anleitung.md for the wiring):
#   in.00 X home   in.01 Y1 home   in.02 Y2 home   in.03 Z home
#   in.04 probe    in.06 drive alarm (all drives)   in.07 e-stop (handled by the board)

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt cncboard_spi device=/dev/spidev0.0 speed_hz=2000000 joints=4
loadrt pid names=pid.x,pid.y1,pid.y2,pid.z
loadrt or2 names=or2.fault

addf motion-command-handler servo-thread
addf motion-controller      servo-thread
addf pid.x.do-pid-calcs     servo-thread
addf pid.y1.do-pid-calcs    servo-thread
addf pid.y2.do-pid-calcs    servo-thread
addf pid.z.do-pid-calcs     servo-thread
addf or2.fault              servo-thread
addf cncboard.update        servo-thread

# ---- e-stop and enable ----------------------------------------------------
# LinuxCNC can only leave e-stop while the link to the board is up and the
# board's e-stop input is closed.
net estop-ok    cncboard.ok => iocontrol.0.emc-enable-in
# Machine on -> board runs and switches the drives on.
net machine-on  motion.motion-enabled => cncboard.enable

# A board fault (link lost, e-stop) or a drive alarm switches the machine off.
net board-fault cncboard.fault  => or2.fault.in0
net drive-alarm cncboard.in.06  => or2.fault.in1
net amp-fault   or2.fault.out   => joint.0.amp-fault-in joint.1.amp-fault-in joint.2.amp-fault-in joint.3.amp-fault-in

# ---- joints -----------------------------------------------------------------
# The board generates steps from a velocity command. The pid closes the
# position loop on the step count: FF1 passes the commanded velocity through,
# Pgain removes what is left. Pgain must stay well below 1/servo period (1000)
# because the feedback is about two servo periods old.

# joint 0: X
setp cncboard.joint.0.scale [JOINT_0]SCALE
setp pid.x.Pgain 200
setp pid.x.FF1 1
setp pid.x.maxoutput [JOINT_0]MAX_VELOCITY
net x-pos-cmd  joint.0.motor-pos-cmd  => pid.x.command
net x-pos-fb   cncboard.joint.0.pos-fb => pid.x.feedback joint.0.motor-pos-fb
net x-vel-cmd  pid.x.output           => cncboard.joint.0.vel-cmd
net x-enable   joint.0.amp-enable-out => pid.x.enable
net x-home     cncboard.in.00         => joint.0.home-sw-in

# joint 1: Y1
setp cncboard.joint.1.scale [JOINT_1]SCALE
setp pid.y1.Pgain 200
setp pid.y1.FF1 1
setp pid.y1.maxoutput [JOINT_1]MAX_VELOCITY
net y1-pos-cmd joint.1.motor-pos-cmd  => pid.y1.command
net y1-pos-fb  cncboard.joint.1.pos-fb => pid.y1.feedback joint.1.motor-pos-fb
net y1-vel-cmd pid.y1.output          => cncboard.joint.1.vel-cmd
net y1-enable  joint.1.amp-enable-out => pid.y1.enable
net y1-home    cncboard.in.01         => joint.1.home-sw-in

# joint 2: Y2
setp cncboard.joint.2.scale [JOINT_2]SCALE
setp pid.y2.Pgain 200
setp pid.y2.FF1 1
setp pid.y2.maxoutput [JOINT_2]MAX_VELOCITY
net y2-pos-cmd joint.2.motor-pos-cmd  => pid.y2.command
net y2-pos-fb  cncboard.joint.2.pos-fb => pid.y2.feedback joint.2.motor-pos-fb
net y2-vel-cmd pid.y2.output          => cncboard.joint.2.vel-cmd
net y2-enable  joint.2.amp-enable-out => pid.y2.enable
net y2-home    cncboard.in.02         => joint.2.home-sw-in

# joint 3: Z
setp cncboard.joint.3.scale [JOINT_3]SCALE
setp pid.z.Pgain 200
setp pid.z.FF1 1
setp pid.z.maxoutput [JOINT_3]MAX_VELOCITY
net z-pos-cmd  joint.3.motor-pos-cmd  => pid.z.command
net z-pos-fb   cncboard.joint.3.pos-fb => pid.z.feedback joint.3.motor-pos-fb
net z-vel-cmd  pid.z.output           => cncboard.joint.3.vel-cmd
net z-enable   joint.3.amp-enable-out => pid.z.enable
net z-home     cncboard.in.03         => joint.3.home-sw-in

# ---- probe ---------------------------------------------------------------------
net probe      cncboard.in.04 => motion.probe-input

# ---- outputs --------------------------------------------------------------------
net flood      iocontrol.0.coolant-flood => cncboard.out.00
net mist       iocontrol.0.coolant-mist  => cncboard.out.01
# The spindle is not connected in this configuration (switch it by hand).

# ---- manual tool change ------------------------------------------------------------
loadusr -W hal_manualtoolchange
net tool-change   iocontrol.0.tool-change      => hal_manualtoolchange.change
net tool-changed  hal_manualtoolchange.changed => iocontrol.0.tool-changed
net tool-number   iocontrol.0.tool-prep-number => hal_manualtoolchange.number
net tool-prepare  iocontrol.0.tool-prepare     => iocontrol.0.tool-prepared
